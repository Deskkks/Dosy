generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  moduleFormat  = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int           @id @default(autoincrement())
  nome         String
  email        String        @unique
  senha        String        @unique
  cuidadorId   Int?
  TokenFCM     String?
  cuidador     User?         @relation("UserCuidador", fields: [cuidadorId], references: [id])
  cuidadores   User[]        @relation("UserCuidador")
  historicos   historico[]
  medicamentos medicamento[]
}

model medicamento {
  id                Int         @id @default(autoincrement())
  nome              String
  frequencia        Int
  dosagem           Int
  unidadeDosagem    String
  quantidade        Int
  unidadeQuantidade String
  dataInicio        DateTime
  dataFim           DateTime
  status            Status      @default(ativo)
  userId            Int
  historicos        historico[]
  user              User        @relation(fields: [userId], references: [id])
}

model historico {
  id            Int         @id @default(autoincrement())
  data          DateTime    @default(now())
  medicamentoId Int
  userId        Int
  medicamento   medicamento @relation(fields: [medicamentoId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
}

enum Status {
  ativo
  inativo
  sob_demanda
}
